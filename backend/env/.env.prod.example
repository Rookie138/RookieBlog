# BlogSystem 生产环境变量模板
# 用法：cp 此文件为 env/.env.prod 并修改后使用（系统服务里 ENVIRONMENT=prod 即读取它）
# 生成密钥：openssl rand -hex 32

ENVIRONMENT="prod"

# 文档配置
TITLE="BlogSystem"
VERSION="0.1.0"

# 登录签发密钥（生产必须改成强随机值）
SECRET_KEY="change-me-please-run-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# 数据库（生产不打印 SQL）
DATABASE_ECHO=False
EXPIRE_ON_COMMIT=False

DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_USER="blog"
DATABASE_PASSWORD="change-me-please"
DATABASE_NAME="blog"
